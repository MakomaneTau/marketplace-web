{
  "name": "marketplace-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint:fix": "eslint . --fix",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test",
    "audit": "npm audit",
    "audit:production": "npm audit --omit=dev"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^1.27.0",
    "next": "^16.2.12",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-icons": "^5.7.0",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@next/eslint-plugin-next": "16.4.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.12",
    "eslint-import-resolver-typescript": "^3.10.1",
    "prettier": "3.9.10",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "engines": {
    "node": "^22.13.0"
  },
  "overrides": {
    "@next/eslint-plugin-next@16.4.0": {
      "fast-glob": "file:../../../tooling/next-root-glob"
    }
  },
  "allowScripts": {
    "unrs-resolver@1.12.2": true
  }
}
